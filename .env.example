# Production environment variables – the 7 that must be set on Vercel.
# For the full reference (user-level API keys, mailboxes, LLM, Sheets, daily
# limits, etc.) see docs/API_KEYS.md. User-level keys (Brave, Groq, Hunter,
# Places) are entered per-account in Settings, not here.

# --- Database (Postgres/Supabase) --- REQUIRED, runtime
GTM_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- Authentication (Supabase Auth) --- REQUIRED, runtime
GTM_SUPABASE_URL=https://your-project.supabase.co

# --- Encryption (per-user API key storage) --- REQUIRED, runtime
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GTM_ENCRYPTION_KEY=

# --- GitHub Actions dispatch --- REQUIRED for campaign runs, runtime
GTM_GITHUB_TOKEN=
GTM_GITHUB_REPO=grydinteam/qualifyr

# --- Frontend (Supabase client) --- REQUIRED, BUILD-TIME (redeploy after changing)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- PayPal lead-to-cash (hackathon) --- OPTIONAL, runtime, sandbox only by default
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox, copy its
# Client ID and Secret. Secrets live in environment variables only; never commit them.
GTM_PAYPAL_CLIENT_ID=
GTM_PAYPAL_CLIENT_SECRET=
# Webhook ID from Developer Dashboard > your app > Webhooks (URL: https://<your-host>/api/webhooks/paypal,
# events: INVOICING.INVOICE.CREATED / SENT / PAID / CANCELLED / REFUNDED). Without it payments do not
# update automatically; invoices can still be refreshed manually.
GTM_PAYPAL_WEBHOOK_ID=
# Optional: shown as the invoice sender name; comma-separated currencies PayPal settles for you.
GTM_PAYPAL_BUSINESS_NAME=
GTM_PAYPAL_CURRENCIES=USD,EUR,GBP
# Live mode needs BOTH of these. Leave unset: the hackathon build is sandbox-only.
# GTM_PAYPAL_ENV=live
# GTM_PAYPAL_ALLOW_LIVE=1
