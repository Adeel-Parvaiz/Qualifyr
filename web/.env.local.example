# Copy to .env.local. These Firebase web settings are available in your Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials. Use Application Default Credentials locally
# when possible; otherwise provide a service-account JSON value through a secret manager.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Browser requests use the same origin locally, through ngrok, and on Vercel.
NEXT_PUBLIC_API_URL=/api
# Local Next.js proxy destination. Ignored on Vercel (see vercel.json).
API_PROXY_TARGET=http://127.0.0.1:8000
# Optional: exact ngrok hostname, without https:// or a path.
NGROK_DOMAIN=
