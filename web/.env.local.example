# Copy to .env.local. Public Supabase credentials come from your project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported.

# Browser requests use the same origin locally, through ngrok, and on Vercel.
NEXT_PUBLIC_API_URL=/api
# Local Next.js proxy destination. Ignored on Vercel (see vercel.json).
API_PROXY_TARGET=http://127.0.0.1:8000
# Optional: exact ngrok hostname, without https:// or a path.
NGROK_DOMAIN=
